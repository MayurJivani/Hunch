[Unit]
Description=hunch (live guessing game, Socket.IO)
After=network-online.target

[Service]
WorkingDirectory=/opt/apps/Hunch
# Optional overrides only; nothing here is secret. (PUBLIC_CAPACITY, PUBLIC_PACE, SOCKETS_PER_IP)
EnvironmentFile=-/etc/apps/hunch.env
Environment=NODE_ENV=production PORT=4351 PUBLIC_DATA=/var/lib/hunch/public.json
ExecStart=/usr/bin/node server/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=512M
StateDirectory=hunch
# --- least privilege: a throwaway user per start, no capabilities, read-only code ---
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
NoNewPrivileges=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# A blocked call fails with EPERM instead of killing the process.
SystemCallErrorNumber=EPERM
UMask=0077
# No MemoryDenyWriteExecute: V8's JIT needs writable+executable pages.

[Install]
WantedBy=multi-user.target
